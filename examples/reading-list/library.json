{
  "schemaVersion": 2,
  "canvasId": "canvas-reading-list-example",
  "library": {
    "id": "design-library-reading-list",
    "title": "Reading List UI Kit",
    "version": "v1",
    "description": "Canvas-local Design Library definitions read by both Agents and people."
  },
  "foundations": [],
  "layouts": [],
  "components": [
    {
      "id": "ui-button",
      "name": "Button",
      "description": "Semantic button that runs an explicit user action.",
      "contract": {
        "element": "button",
        "className": "sc-button",
        "props": {
          "variant": {
            "type": "enum",
            "values": ["primary", "secondary"],
            "default": "primary",
            "description": "Importance of the action"
          }
        },
        "slots": ["default"],
        "events": ["click"],
        "states": ["default", "hover", "focus-visible", "disabled"],
        "tokens": ["color.accent", "space.4", "radius.md"]
      },
      "accessibility": ["Accessible name required", "Keep the keyboard focus indicator visible"],
      "guidance": {
        "use": ["Verb-phrase action wording"],
        "avoid": ["Rendering a navigation link as a button"]
      },
      "preview": {
        "tag": "button",
        "className": "sc-button",
        "text": "Open book",
        "attributes": { "type": "button" }
      },
      "stories": [
        { "id": "story-button-primary", "title": "Primary", "props": { "variant": "primary" } },
        { "id": "story-button-secondary", "title": "Secondary", "props": { "variant": "secondary" } }
      ]
    },
    {
      "id": "ui-book-card",
      "name": "Book card",
      "description": "List card summarizing one book's title, author and reading progress.",
      "contract": {
        "element": "article",
        "className": "sc-book-card",
        "props": {
          "progress": {
            "type": "enum",
            "values": ["unread", "reading", "done"],
            "default": "unread",
            "description": "Reading progress state"
          }
        },
        "slots": ["title", "author", "meta"],
        "events": ["click"],
        "states": ["default", "hover", "focus-visible"],
        "tokens": ["color.surface", "color.border", "radius.lg", "shadow.surface"]
      },
      "accessibility": ["Provide an accessible name when the whole card is a single click target"],
      "guidance": {
        "use": ["Repeat the same information structure across the list"],
        "avoid": ["Nesting several independent buttons inside a card"]
      },
      "preview": {
        "tag": "article",
        "className": "sc-book-card",
        "text": "Sample book title",
        "attributes": {}
      },
      "stories": [
        { "id": "story-book-card-reading", "title": "Reading", "props": { "progress": "reading" } }
      ]
    }
  ]
}
