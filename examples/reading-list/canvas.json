{
  "schemaVersion": 2,
  "canvas": {
    "id": "canvas-reading-list-example",
    "title": "Reading List — Supercanvas Example",
    "version": "v1",
    "language": "en"
  },
  "sources": {
    "tokens": "design/tokens.json",
    "library": "library.json",
    "rules": "rules.json",
    "relations": "relations.json",
    "actions": "actions.json",
    "notes": "notes.json",
    "feedback": "feedback.json"
  },
  "styles": ["styles/canvas.css"],
  "layout": {
    "padding": 80,
    "gap": 120
  },
  "frames": [
    {
      "id": "frame-reading-home",
      "title": "Reading list",
      "summary": "Entry screen that lists saved books; clicking the first item opens the detail screen.",
      "kind": "desktop",
      "tags": ["example", "list", "action"],
      "uses": ["design/tokens.json", "styles/canvas.css"],
      "libraryUses": ["ui-button", "ui-book-card"],
      "source": "frames/frame-reading-home.html",
      "width": 880,
      "height": 640,
      "x": 80,
      "y": 80
    },
    {
      "id": "frame-reading-detail",
      "title": "Book detail",
      "summary": "Outcome screen showing one book's notes and reading progress, with a way back to the list.",
      "kind": "desktop",
      "tags": ["example", "action-outcome", "detail"],
      "uses": ["design/tokens.json", "styles/canvas.css"],
      "libraryUses": ["ui-button"],
      "source": "frames/frame-reading-detail.html",
      "width": 880,
      "height": 640,
      "x": 1080,
      "y": 80
    }
  ]
}
